# Copy this file to ".env" (same folder). ".env" is never published.
DATABASE_URL=postgresql+psycopg2://ai_study:ai_study_password@localhost:5433/ai_study_db

# Optional. The key that signs login tokens. If left out, a random key is
# created on first start and kept in the local file ".secret_key".
# JWT_SECRET=

# Optional. Speech-recognition model for audio sources:
# tiny, base, small, medium, large-v3-turbo (default), large-v3.
# WHISPER_MODEL=large-v3-turbo

# Optional. A proxy through which the server reaches YouTube, for example
# http://user:password@host:port. Needed only if the server itself fetches
# captions from a data-centre address, which YouTube refuses.
# YOUTUBE_PROXY_URL=
